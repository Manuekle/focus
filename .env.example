# ── Meta Model API (server-only; never exposed to the browser) ─────────────
# Required for AI editing. META_API_KEY is accepted as a fallback name.
MODEL_API_KEY=

# ── Upload limits (server-side; put them in .env.local) ────────────────────
# The server enforces them at runtime. The interface shows the validated
# values compiled at build time: rebuild (or restart pnpm dev) after a change.
# Duration 1–600 s (SAM 3.1 tracks up to ~10 min), size 1–1024 MB; anything
# else falls back to the defaults below.
# FOCUS_MAX_VIDEO_DURATION_SECONDS=60
# FOCUS_MAX_UPLOAD_MB=150
# FOCUS_MAX_IMAGE_UPLOAD_MB=15
# FOCUS_MAX_DATA_MB=0             # 0 disables the data budget; Railway trial: 350
# FOCUS_MIN_FREE_MB=100           # Free disk space kept aside when the budget is on

# ── Storage ────────────────────────────────────────────────────────────────
# Uploads, masks and renders. Expire after 24 h. Default: ./.focus-data
# FOCUS_DATA_DIR=/data
# Railway deployment values and volume setup: deploy/railway.env.example
# and docs/RAILWAY.md. Railway uses the Dockerfile + railway.json.

# ── Abuse and cost protection (public deployments) ─────────────────────────
# Emergency switch: 1 refuses all new Meta AI work.
# FOCUS_AI_DISABLED=0
# Paid AI requests (new edits, gap fills, point prompts) per client per hour.
# FOCUS_AI_REQUESTS_PER_HOUR=30
# Uploads per client per hour.
# FOCUS_UPLOADS_PER_HOUR=20
# AI editor chat messages per client per hour (one small Muse Spark call each, no SAM).
# FOCUS_CHAT_PER_HOUR=60
# FOCUS_RENDERS_PER_HOUR=60
# Jobs running at once across all clients.
# FOCUS_MAX_ACTIVE_JOBS=4
# Parallel slots per kind of work (1–16). Raise on bigger machines or API tiers.
# FOCUS_PLANNER_CONCURRENCY=2        # Muse Spark plans
# FOCUS_SEGMENTATION_CONCURRENCY=1   # SAM 3.1 video passes
# FOCUS_IMAGE_CONCURRENCY=2          # Muse Image drawings
# FOCUS_RENDER_CONCURRENCY=1         # FFmpeg compositor renders (CPU-bound)
# SAM 3.1 frames per UTC day (0 = no budget). Each request bills >= 50 frames.
# A 60 s clip is 1,440 frames at 24 fps: the default allows about 13 per day.
# FOCUS_SAM_DAILY_FRAMES=20000
# Behind a reverse proxy: identify clients by X-Forwarded-For.
# FOCUS_TRUST_PROXY=0
# Enables GET /api/usage and the /settings page in production with header
# X-Focus-Admin: <token>. Set it on your platform: /settings can't change it.
# Values saved on /settings live in <FOCUS_DATA_DIR>/settings/env.json.
# FOCUS_ADMIN_TOKEN=

# ── Optional overrides ─────────────────────────────────────────────────────
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# META_BASE_URL=https://api.meta.ai/v1
# META_PLANNER_MODEL=muse-spark-1.3-contributor
# META_SEGMENTATION_MODEL=sam-3.1
# META_IMAGE_MODEL=muse-image-1.0
# Flipbook: Muse Image drawings per animation before an explicit confirmation is required.
# FOCUS_FLIPBOOK_IMAGE_BUDGET=16
# My characters: image generations per character; saved versions remain usable at the limit.
# FOCUS_CHARACTER_IMAGE_BUDGET=16

# Accounts. Required in production: signs session cookies (32+ characters).
# Generate one with: openssl rand -base64 48
# FOCUS_SESSION_SECRET=
# Lifetime generations per account in production (also for anonymous visitors).
# Local development (pnpm dev / NODE_ENV=development) has no generation quota.
# FOCUS_FREE_EDITS=3
# Facebook Login (Meta app). Without these, a simulated sign-in runs locally.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_GRAPH_VERSION=v23.0
# Public origin for OAuth, canonical links, social previews and the sitemap.
# Set before next build to override the default https://focusmeta.up.railway.app.
# FOCUS_PUBLIC_URL=
# Allow the simulated sign-in on a production build (testing only).
# FOCUS_AUTH_SIMULATED=0

# ── Release flags (public: booleans only, never secrets) ───────────────────
# Time Freeze + Echo, the temporal effect. Off unless exactly "true".
# Set before next build; rebuild to switch a production release on or off.
# Docker: --build-arg NEXT_PUBLIC_ENABLE_TEMPORAL_EFFECTS=true (not docker run -e).
# NEXT_PUBLIC_ENABLE_TEMPORAL_EFFECTS=false
# Focus Flipbook: frame-by-frame walk cycles from one illustration (/flipbook).
# Off unless exactly "true". Compiled in like the temporal flag: restart dev / rebuild to switch.
# NEXT_PUBLIC_ENABLE_FLIPBOOK=false

# ── Reference Motion (character follows a video; GPU worker) ───────────────
# Off unless exactly "true"; compiled in like the Flipbook flag.
# NEXT_PUBLIC_ENABLE_REFERENCE_MOTION=false

# ── Rotoscope (video redrawn frame by frame with your character) ────────────
# Off unless exactly "true"; compiled in like the Flipbook flag. Needs DWPose:
# the worker's Python environment (services/animation-worker, `pip install .[pose]`).
# NEXT_PUBLIC_ENABLE_ROTOSCOPE=false
# Python with rtmlib; defaults to services/animation-worker/.venv/bin/python.
# ROTOSCOPE_PYTHON=

# ── Pose to pose (keys, timing chart, in-betweens by halves) ─────────────────
# Off unless exactly "true": described sequences are then planned pose to pose.
# NEXT_PUBLIC_ENABLE_POSE_TO_POSE=false
# The private GPU worker (services/animation-worker). Token shared with it.
# GPU_WORKER_URL=
# GPU_WORKER_TOKEN=
# Signs the short-lived URLs the worker uses to fetch inputs and upload results.
# Required in production (32+ characters): openssl rand -hex 32
# ANIMATION_URL_SECRET=
# Where the worker reaches Focus; defaults to FOCUS_PUBLIC_URL.
# ANIMATION_CALLBACK_BASE_URL=
# ANIMATION_DEFAULT_ENGINE=steadydancer
# ANIMATION_MAX_DURATION_SECONDS=3
# ANIMATION_MAX_ACTIVE_JOBS_PER_USER=1
# ANIMATION_MAX_ACTIVE_JOBS=1
# ANIMATION_JOBS_PER_HOUR=6
# ANIMATION_JOB_TIMEOUT_SECONDS=2700

# ── Higgsfield (server-only; optional second rotoscope generator) ──────────
# "key-id:key-secret" from https://cloud.higgsfield.ai. Put it in .env.local,
# never in the browser. With it, Rotoscope can draw every attempt twice
# (Muse Image + Higgsfield) and keep the drawing that measures closer.
# HF_CREDENTIALS=
# HIGGSFIELD_IMAGE_MODEL=xai/grok-imagine-image-2.0
