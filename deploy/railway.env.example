# Paste into the Railway service's Variables / Raw Editor, then fill secrets.
# This file contains no credentials. Never commit the filled-in values.
# Railway passes declared Docker ARGs to the build; set these BEFORE deploying.
NEXT_PUBLIC_ENABLE_FLIPBOOK=true
NEXT_PUBLIC_ENABLE_TEMPORAL_EFFECTS=false
FOCUS_MAX_VIDEO_DURATION_SECONDS=15
FOCUS_MAX_UPLOAD_MB=10
FOCUS_MAX_IMAGE_UPLOAD_MB=5
# Stop new media before the 500 MB trial volume fills. Keep saved assets.
FOCUS_MAX_DATA_MB=350
FOCUS_MIN_FREE_MB=100

# Demo trial: attach a 500 MB persistent volume at /data.
# railway.json refuses a missing mount; upgrade resources after measuring use.
# Only the entrypoint starts as root; it immediately drops to the node user.
RAILWAY_RUN_UID=0
FOCUS_DATA_DIR=/data

FOCUS_AI_DISABLED=0
# Checks Meta's authenticated model catalog at startup; no model usage.
FOCUS_PROVIDER_CONNECTIVITY_CHECK=1
FOCUS_MAX_ACTIVE_JOBS=1
FOCUS_AI_REQUESTS_PER_HOUR=10
FOCUS_UPLOADS_PER_HOUR=10
FOCUS_CHAT_PER_HOUR=20
FOCUS_SAM_DAILY_FRAMES=2000
FOCUS_FLIPBOOK_IMAGE_BUDGET=16
FOCUS_FREE_EDITS=3

# Railway supplies X-Real-IP. Leave arbitrary X-Forwarded-For trust disabled.
FOCUS_TRUST_PROXY=0
FOCUS_AUTH_SIMULATED=0

# Required: use a production Meta Model API key and a random 32+ character key.
MODEL_API_KEY=
FOCUS_SESSION_SECRET=
# Optional, recommended for the protected /api/usage endpoint.
FOCUS_ADMIN_TOKEN=

# Railway reference, resolved after generating a public domain for the service.
# Replace this value when switching to a custom domain.
FOCUS_PUBLIC_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}

# Required for real sign-in and saving work; sign-in does not reset the allowance.
# Register <FOCUS_PUBLIC_URL>/api/auth/facebook/callback in the Meta app.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v26.0
