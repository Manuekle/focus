{
  "name": "@focus/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Focus: editor de video con Meta Muse Spark y SAM 3.1.",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3200",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3200",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "test": "vitest run",
    "test:load": "FOCUS_RUN_LOAD_TESTS=1 vitest run server/jobs.load.test.ts --maxWorkers=1",
    "test:live": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --config vitest.live.config.ts",
    "test:live:temporal": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --config vitest.live.config.ts server/video/temporal.live.test.ts",
    "test:e2e": "playwright test"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.3.0",
    "@hugeicons/react": "1.1.10",
    "@lucasmarkes/hairline": "0.3.0",
    "@meta-sam/parser": "^0.1.0",
    "@radix-ui/react-use-controllable-state": "1.2.2",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/postcss": "4.3.0",
    "beautiful-mermaid": "1.1.3",
    "border-beam": "1.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cube-motion": "0.1.0",
    "cuelume": "0.2.8",
    "lenis": "1.3.26",
    "liquid-gooey": "0.2.0",
    "motion": "12.40.0",
    "openai": "^7.43.0",
    "radix-ui": "1.4.3",
    "sharp": "^0.35.5",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "thinking-orbs": "0.3.1",
    "voice-glow": "0.2.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "24.13.2",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "next": "16.4.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "typescript": "6.0.3",
    "vitest": "4.0.8"
  },
  "packageManager": "pnpm@12.11.2",
  "files": [
    "components",
    "lib",
    "styles",
    "tokens",
    "public/fonts",
    "public/logos/apps",
    "public/brand",
    "examples",
    "docs",
    "README.md",
    "provenance.json"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
