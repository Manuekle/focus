# Reverse proxy for docker-compose.enterprise.yml — the static counterpart of
# deploy/roles/caddy/templates/Caddyfile.j2, which the Ansible path renders.
#
# One site, two upstreams:
#   /eve/* and /.well-known/workflow/*  -> eve:3000 (agent host + the Workflow
#                                          callback; without the second prefix
#                                          sessions start and then stall)
#   everything else                     -> web:3001 (Next.js UI and /api)
#
# The address comes from ORUKA_SITE_ADDRESS in .env:
#   unset           -> ":80", plain HTTP — a local trial on http://localhost
#   oruka.si  -> automatic HTTPS from Let's Encrypt; DNS must point here
#                      and ports 80 and 443 must be reachable
{$ORUKA_SITE_ADDRESS::80} {
	@eve path /eve/* /.well-known/workflow/*
	reverse_proxy @eve eve:3000 {
		# Session streams are long-lived NDJSON: flush every chunk as it
		# arrives instead of buffering a turn's output.
		flush_interval -1
	}
	reverse_proxy web:3001
}
