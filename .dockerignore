# Never send secrets, local media or build output into the image context.
.env
.env.*
!.env.example
*.env
**/*.env
.focus-data
.focus-data-*
node_modules
.next
.git
.claude
.agents
.gstack
.codex
AGENTS.md
CLAUDE.md
.pnpm-store
test-results
playwright-report
*.tsbuildinfo
*.mp4
!public/demo/**/*.mp4
*.mov
PHASES

# Only the worker's Python (app, scripts, pyproject) goes in: Rotoscope runs it. The GPU worker is its own image.
services/animation-worker/.venv
services/animation-worker/.pytest_cache
services/animation-worker/tests
services/animation-worker/Dockerfile
**/__pycache__

# Local debug and repair runs (single_frame_debug, rebuilt runs): never in an image.
debug_runs
